{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomeskills.io/schemas/enrichment.v1.json",
  "title": "awesomeskills agent enrichment batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "agent", "model", "entries", "repos"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "generated_at": {"type": "string", "minLength": 10},
    "agent": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content_sha256", "function", "scope"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "scope": {"type": "string", "minLength": 1},
          "function": {"$ref": "#/$defs/bilingualFunction"}
        }
      }
    },
    "repos": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    }
  },
  "$defs": {
    "functionSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "scenarios", "io", "dependencies", "boundary"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "io": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "bilingualFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"$ref": "#/$defs/functionSide"},
        "zh": {"$ref": "#/$defs/functionSide"}
      }
    }
  }
}
